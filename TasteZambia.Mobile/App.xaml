<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TasteZambia.Mobile"
             xmlns:converters="clr-namespace:TasteZambia.Mobile.Converters"
             x:Class="TasteZambia.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InvertedBoolConverter x:Key="InvertedBool"/>
            <converters:HexToColorConverter x:Key="HexToColor"/>
            <converters:BoolToIconVariantConverter x:Key="BoolToIconVariant"/>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacity"/>
            <converters:HasTextConverter x:Key="HasText"/>
            <converters:BoolToCheckFillConverter x:Key="BoolToCheckFill"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
