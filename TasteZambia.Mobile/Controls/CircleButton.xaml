<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ic="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
             x:Class="TasteZambia.Mobile.Controls.CircleButton"
             x:Name="Root">

    <!-- The visual circle is 24-36pt per the design, but the hit target is never
         below 44pt: the outer grid is the tappable surface and carries the semantic
         description, the inner border is only the drawing. -->
    <Grid x:Name="Surface" BindingContext="{x:Reference Root}"
          MinimumWidthRequest="44" MinimumHeightRequest="44"
          BackgroundColor="Transparent">
        <Border WidthRequest="{Binding Diameter}"
                HeightRequest="{Binding Diameter}"
                BackgroundColor="{Binding CircleBackground}"
                StrokeThickness="0"
                StrokeShape="{Binding Shape}"
                Padding="0"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                AutomationProperties.IsInAccessibleTree="False">
            <ic:FluentIcon Icon="{Binding Icon}"
                           IconVariant="{Binding IconVariant}"
                           IconSize="{Binding IconSize}"
                           ForegroundColor="{Binding IconColor}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
        </Border>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command}"/>
        </Grid.GestureRecognizers>
    </Grid>
</ContentView>
