<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ic="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
             x:Class="TasteZambia.Mobile.Controls.CircleButton"
             x:Name="Root">

    <Border BindingContext="{x:Reference Root}"
            WidthRequest="{Binding Diameter}"
            HeightRequest="{Binding Diameter}"
            BackgroundColor="{Binding Background}"
            StrokeThickness="0"
            StrokeShape="{Binding Shape}"
            Padding="0">
        <ic:FluentIcon Icon="{Binding Icon}"
                       IconVariant="{Binding IconVariant}"
                       IconSize="{Binding IconSize}"
                       ForegroundColor="{Binding IconColor}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command}"/>
        </Border.GestureRecognizers>
    </Border>
</ContentView>
