<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TasteZambia.Mobile.Controls"
             xmlns:vm="clr-namespace:TasteZambia.Core.ViewModels;assembly=TasteZambia.Core"
             xmlns:models="clr-namespace:TasteZambia.Core.Models;assembly=TasteZambia.Core"
             x:Class="TasteZambia.Mobile.Views.Collections.FamilyRecipesView"
             x:DataType="vm:FamilyRecipesViewModel">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <VerticalStackLayout Padding="20,18,20,16" Spacing="0">
                <controls:CircleButton Icon="ArrowLeft" Diameter="34" CircleBackground="Transparent"
                                       Margin="0,0,0,16" SemanticLabel="Back to profile"
                                       IconColor="{StaticResource TzInk}" HorizontalOptions="Start"
                                       Command="{Binding BackToProfileCommand}"/>
                <Label Text="{Binding CountLabel}" Style="{StaticResource KickerLabel}" TextColor="{StaticResource TzGreenDeep}" Margin="0,0,0,9"/>
                <Label Text="My Family Recipes" Style="{StaticResource DisplayTitle}" FontSize="30" CharacterSpacing="-0.3"/>
                <Label Text="Recipes recorded from the people who taught you them." Margin="0,9,0,0" Style="{StaticResource BodySmall}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Padding="20,0" Spacing="12" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:PreservedRecipe">
                        <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 18" Padding="16">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Name}" FontFamily="NewsreaderSemiBold" FontSize="19" LineHeight="1.15"
                                               TextColor="{StaticResource TzInk}"/>
                                        <Label FontFamily="ArchivoRegular" FontSize="11" LineHeight="1.4" TextColor="{StaticResource TzMuted}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="As taught by "/>
                                                    <Span Text="{Binding TaughtBy}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <controls:PillLabel Grid.Column="1" Text="{Binding Privacy}" VerticalOptions="Start"
                                                        PillBackground="{Binding BadgeBgHex, Converter={StaticResource HexToColor}}"
                                                        TextColor="{Binding BadgeFgHex, Converter={StaticResource HexToColor}}"/>
                                </Grid>
                                <Label Text="{Binding Extras}" Margin="0,12,0,0" FontFamily="PlexMonoRegular" FontSize="10.5"
                                       TextColor="{StaticResource TzMuted2}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border Margin="20" Stroke="{StaticResource TzBorderDashed}" StrokeThickness="1" StrokeDashArray="4,3"
                    StrokeShape="RoundRectangle 14" Padding="15" BackgroundColor="Transparent">
                <Label Text="+ Preserve another recipe" FontFamily="ArchivoSemiBold" FontSize="12.5"
                       HorizontalOptions="Center" TextColor="{StaticResource TzGold}"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PreserveAnotherCommand}"/>
                </Border.GestureRecognizers>
            </Border>
            <BoxView HeightRequest="6" Color="Transparent"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
