<?xml version="1.0" encoding="utf-8" ?>
<views:LoadOnceView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:TasteZambia.Mobile.Views"
             xmlns:controls="clr-namespace:TasteZambia.Mobile.Controls"
             xmlns:vm="clr-namespace:TasteZambia.Core.ViewModels;assembly=TasteZambia.Core"
             xmlns:models="clr-namespace:TasteZambia.Core.Models;assembly=TasteZambia.Core"
             x:Class="TasteZambia.Mobile.Views.Share.ShareChangesView"
             x:DataType="vm:ShareChangesViewModel">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <VerticalStackLayout Padding="20,18,20,18" BackgroundColor="{StaticResource TzGoldTint}" Spacing="0">
                <controls:CircleButton Icon="ArrowLeft" Diameter="34" CircleBackground="Transparent"
                                       SemanticLabel="Go back" IconColor="{StaticResource TzInk}"
                                       HorizontalOptions="Start" Margin="0,0,0,14" Command="{Binding BackCommand}"/>
                <Border HorizontalOptions="Start" BackgroundColor="#1FA3452A" Stroke="#59A3452A" StrokeThickness="1"
                        StrokeShape="RoundRectangle 20" Padding="11,5" Margin="0,0,0,13">
                    <Label Text="CHANGES REQUESTED" FontFamily="ArchivoMedium" FontSize="9.5" CharacterSpacing="0.38"
                           TextColor="{StaticResource TzClayText}"/>
                </Border>
                <Label SemanticProperties.HeadingLevel="Level1" Text="Two questions before we publish" FontFamily="NewsreaderSemiBold" FontSize="28"
                       LineHeight="1.1" TextColor="{StaticResource TzInk}"/>
                <Label Text="Nothing was changed. The reviewer has asked rather than edited." Margin="0,9,0,0"
                       FontFamily="ArchivoRegular" FontSize="12.5" LineHeight="1.6" TextColor="{StaticResource TzBodyMuted}"/>
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Margin="20" StrokeShape="RoundRectangle 16" Padding="16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                    <controls:PhotoOrPlaceholder WidthRequest="34" HeightRequest="34" CornerRadius="17"
                                                 ShowCaption="False" VerticalOptions="Start"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="{Binding ReviewerName}" FontFamily="ArchivoSemiBold" FontSize="12.5"
                               LineHeight="1.25" TextColor="{StaticResource TzInk}"/>
                        <Label Text="{Binding ReviewerNote}" FontFamily="ArchivoRegular" FontSize="12"
                               LineHeight="1.65" TextColor="{StaticResource TzBody}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout Padding="20,0" Spacing="12" BindableLayout.ItemsSource="{Binding Flagged}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:FlaggedField">
                        <Border Stroke="#47A3452A" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16"
                                BackgroundColor="{StaticResource TzSurface}">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="{Binding Field}" Style="{StaticResource MicroLabel}"
                                       TextColor="{StaticResource TzClay}" Margin="0,0,0,10"/>
                                <Label Text="{Binding Question}" FontFamily="ArchivoRegular" FontSize="12.5"
                                       LineHeight="1.65" TextColor="{StaticResource TzBody}"/>
                                <Border Margin="0,12,0,0" BackgroundColor="{StaticResource TzCream}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 11" Padding="12">
                                    <Label FontFamily="ArchivoRegular" FontSize="11.5" LineHeight="1.5"
                                           TextColor="{StaticResource TzBodyMuted}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Your entry: "/>
                                                <Span Text="{Binding CurrentValue}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Border>
                                <Border Margin="0,11,0,0" Stroke="{StaticResource TzBorderDashed}" StrokeThickness="1"
                                        StrokeDashArray="4,3" StrokeShape="RoundRectangle 11" Padding="11,4"
                                        BackgroundColor="Transparent">
                                    <Editor Text="{Binding Answer}" Placeholder="Reply or edit this field" AutoSize="TextChanges"
                                            FontFamily="ArchivoRegular" FontSize="12.5" MinimumHeightRequest="44"
                                            TextColor="{StaticResource TzInk}" PlaceholderColor="{StaticResource TzGold}"
                                            BackgroundColor="Transparent" TextChanged="OnAnswerChanged"
                                            SemanticProperties.Description="{Binding Field, StringFormat='Your reply about {0}'}"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="{Binding ActionError}" IsVisible="{Binding ActionError, Converter={StaticResource HasText}}"
                   Margin="20,0,20,10" FontFamily="ArchivoMedium" FontSize="12" LineHeight="1.5"
                   TextColor="{StaticResource TzClayText}"/>

            <Border Style="{StaticResource PrimaryAction}" Margin="20"
                    Opacity="{Binding CanResubmit, Converter={StaticResource BoolToOpacity}}">
                <Label Text="Resubmit for review" FontFamily="ArchivoSemiBold" FontSize="13.5"
                       HorizontalOptions="Center" TextColor="{StaticResource TzSurface}"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ResubmitCommand}"/>
                </Border.GestureRecognizers>
            </Border>
            <BoxView HeightRequest="6" Color="Transparent"/>
        </VerticalStackLayout>
    </ScrollView>
</views:LoadOnceView>
