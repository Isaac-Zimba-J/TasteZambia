<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TasteZambia.Core.ViewModels;assembly=TasteZambia.Core"
             x:Class="TasteZambia.Mobile.Views.Onboarding.OnbReadyView"
             x:DataType="vm:OnboardingViewModel">

    <Grid Padding="26,34,26,26" RowDefinitions="*,Auto,Auto"
          BackgroundColor="{StaticResource TzGreenDeep}">

        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="0">
            <Image Source="logo.png" WidthRequest="66" HeightRequest="66"
                   Aspect="AspectFit" HorizontalOptions="Start" Margin="0,0,0,24"/>
            <Label Text="Mwaiseni. Welcome to the archive." FontFamily="NewsreaderMedium"
                   FontSize="36" LineHeight="1.04" CharacterSpacing="-0.54"
                   TextColor="{StaticResource TzSurface}"/>
            <Label Text="Start with 120 recipes across ten provinces. It grows every time someone writes down what they were taught."
                   Margin="0,16,0,0" FontFamily="ArchivoRegular" FontSize="13.5" LineHeight="1.75"
                   TextColor="{StaticResource TzOnDark82}"/>

            <BoxView HeightRequest="1" Color="{StaticResource TzOnDark14}" Margin="0,26,0,20"/>

            <VerticalStackLayout Spacing="11">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="Reading in" FontFamily="ArchivoRegular" FontSize="11.5" LineHeight="1.4"
                           TextColor="{StaticResource TzOnDark60}" VerticalOptions="End"/>
                    <Label Grid.Column="1" Text="{Binding PickedLanguage}" FontFamily="NewsreaderSemiBold"
                           FontSize="16" TextColor="{StaticResource TzGoldLight}"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="Coming to it as" FontFamily="ArchivoRegular" FontSize="11.5" LineHeight="1.4"
                           TextColor="{StaticResource TzOnDark60}" VerticalOptions="End"/>
                    <Label Grid.Column="1" Text="{Binding PickedWho}" FontFamily="ArchivoMedium"
                           FontSize="12" LineHeight="1.4" HorizontalTextAlignment="End"
                           TextColor="{StaticResource TzSurface}"/>
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource PrimaryAction}" Padding="17">
            <Label Text="Start exploring" FontFamily="ArchivoSemiBold" FontSize="14.5"
                   HorizontalOptions="Center" TextColor="{StaticResource TzSurface}"/>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding FinishCommand}"/>
            </Border.GestureRecognizers>
        </Border>

        <Label Grid.Row="2" Text="You can change any of this in Settings" Margin="0,14,0,0"
               HorizontalTextAlignment="Center" FontFamily="ArchivoRegular" FontSize="11"
               LineHeight="1.5" TextColor="#9EFFFDF9"/>
    </Grid>
</ContentView>
