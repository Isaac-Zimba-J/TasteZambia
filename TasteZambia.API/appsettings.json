{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "RateLimits": {
    "WindowMinutes": 15,
    "DeviceAuthPerWindow": 20,
    "RefreshPerWindow": 90,
    "WritesPerWindow": 150,
    "GlobalPerWindow": 900
  }
}
