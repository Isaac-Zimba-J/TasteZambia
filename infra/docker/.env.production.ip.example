# For the no-domain deployment (compose.production.ip.yml).
# Copy to the repository root as .env.production, fill in, chmod 600.
# NEVER commit the filled-in file.
#
# There is no API_HOST and no LETSENCRYPT_EMAIL here: without a DNS name there
# is no certificate to issue. The phone reaches the API at http://SERVER_IP:5080.

# The host port the API answers on. Change it only if 5080 is taken on the
# server - the phone build has to be told the same number.
API_PORT=5080

POSTGRES_DB=tastezambia
POSTGRES_USER=tastezambia
# openssl rand -base64 32
POSTGRES_PASSWORD=

JWT_ISSUER=tastezambia
JWT_AUDIENCE=tastezambia-app
# openssl rand -base64 48
# Keep this stable. Changing it signs every phone out and cannot be undone.
JWT_SIGNING_KEY=
