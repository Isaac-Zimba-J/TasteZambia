# Copy to the repository root as .env.production, fill in, chmod 600.
# NEVER commit the filled-in file.

# The hostname the phone talks to. Its DNS A record must already point at this
# server before you bring the stack up, or the certificate challenge fails.
API_HOST=api.tastezambia.example
LETSENCRYPT_EMAIL=you@example.com

POSTGRES_DB=tastezambia
POSTGRES_USER=tastezambia
# openssl rand -base64 32
POSTGRES_PASSWORD=

JWT_ISSUER=tastezambia
JWT_AUDIENCE=tastezambia-app
# openssl rand -base64 48
# Keep this stable. Changing it signs every phone out and cannot be undone.
JWT_SIGNING_KEY=
